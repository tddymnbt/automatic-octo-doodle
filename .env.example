# === REQUIRED SECRETS
# ================================
GEMINI_API_KEY=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=

# ================================
# OPTIONAL SECRETS
# ================================
# GitHub Personal Access Token (classic `repo` scope, or fine-grained with
# Contents: write on this repo). Used by scripts/trigger_pipeline.py to fire
# repository_dispatch events (also how cron-job.org triggers the pipeline).
# NEVER commit a real value.
GITHUB_PAT=

# ================================
# NON-SECRET CONFIGURATION
# ================================

# AI Models
AI_MODEL=gemini-3.5-flash-lite
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_PROVIDER=kokoro
# KOKORO_VOICE is now computed from slot (odd=am_fenrir, even=am_onyx).
# Set this to override the slot-based cycling.
KOKORO_VOICE=
KOKORO_SPEED=0.85
KOKORO_LANG=a

# Audio (reverb) - subtle church/chapel acoustic space
REVERB_ENABLED=false
REVERB_DELAY=30
REVERB_DECAY=0.4
REVERB_WET=0.06

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
TARGET_DURATION_SECONDS=45
MIN_DURATION_SECONDS=30
MAX_DURATION_SECONDS=60
# Asset / ambient directories (project-relative or absolute)
ASSETS_DIR=assets/backgrounds
BACKGROUND_DIR=assets/backgrounds
AMBIENT_DIR=assets/ambient

# Ambient / background production tuning.
# ambient_level is the ambient volume as a fraction of the narration
# (0.15 = 15%). Narration always stays at 1.0, so the voice is clear.
# ambient_fade_in/out: seconds to fade the ambient in at the start and out
# at the end so it swells gently rather than slamming on/off.
# ambient_duck: sidechain-duck the ambient under the narration so music
# recedes while the priest speaks and returns in pauses.
AMBIENT_LEVEL=0.15
AMBIENT_FADE_IN=2.0
AMBIENT_FADE_OUT=2.0
AMBIENT_DUCK=true

# Runtime Settings
DRY_RUN=true
LOG_LEVEL=INFO
TTS_RETRY_COUNT=2

# Content Settings
STORY_LANGUAGE=en
CONTENT_STYLE=gospel_daily_bread

# Facebook Settings
FACEBOOK_GRAPH_VERSION=
FACEBOOK_RETRY_COUNT=3

# Feature Flags
MAX_VISUALS_PER_VIDEO=8
ENABLE_AMBIENT_AUDIO=true
RANDOM_AMBIENT=true
ENABLE_BACKGROUND=true
ENABLE_SUBTITLES=true