# ================================
# REQUIRED SECRETS
# ================================
GEMINI_API_KEY=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=

# ================================
# OPTIONAL SECRETS
# ================================
# GitHub Personal Access Token (classic `repo` scope, or fine-grained with
# Contents: write on this repo). Used by scripts/trigger_pipeline.py to fire
# repository_dispatch events (also how cron-job.org triggers the pipeline).
# NEVER commit a real value.
GITHUB_PAT=

# ================================
# NON-SECRET CONFIGURATION
# ================================

# AI Models
AI_MODEL=gemini-3.5-flash-lite
TTS_MODEL=gemini-3.1-flash-tts-preview
TTS_PROVIDER=kokoro
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0
KOKORO_LANG=a

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
TARGET_DURATION_SECONDS=45
MIN_DURATION_SECONDS=30
MAX_DURATION_SECONDS=60

# Runtime Settings
DRY_RUN=true
LOG_LEVEL=INFO
TTS_RETRY_COUNT=2

# Content Settings
STORY_LANGUAGE=en
CONTENT_STYLE=calm_mysterious_atmospheric

# Facebook Settings
FACEBOOK_GRAPH_VERSION=
FACEBOOK_RETRY_COUNT=3

# Feature Flags
MAX_VISUALS_PER_VIDEO=8
ENABLE_AMBIENT_AUDIO=true
ENABLE_SUBTITLES=true
